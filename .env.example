PORT=3100
SITE_PORT=3100
NODE_ENV=development

# Parent control-plane state. Use /data on Railway when a persistent volume is attached.
CONTROL_PLANE_DATABASE_URL=file:.data/control-plane.db

# Public base URL for links and callbacks.
NEXT_PUBLIC_APP_BASE_URL=http://127.0.0.1:3100

# Railway target metadata. The project token can live in codex-runtime instead of this parent service.
RAILWAY_WORKSPACE_ID=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Prism/Codex integration. Parent submits provisioning jobs here; codex-runtime owns Railway credentials.
CODEX_RUNTIME_BASE_URL=
INTERNAL_SERVICE_TOKEN=
